# Domínio definitivo (sem barra no fim). Enquanto vazio, o site sai em noindex.
SITE_URL=

# Contato (opcional até definir): aparecem no rodapé e na página Contact quando preenchidos
PUBLIC_CONTACT_EMAIL=
PUBLIC_LINKEDIN_URL=
PUBLIC_CNPJ=

# Formulário de contato (função /api/contact/ na Vercel), envio via Resend
RESEND_API_KEY=
# Caixa que recebe os contatos do site (quem faz o 1º contato com o lead; o "Responder" vai direto para quem escreveu)
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Anti-spam opcional (Cloudflare Turnstile)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Medição (Consent Mode, barra de consentimento). Todas carregam 3 s DEPOIS do load, só no build de produção.
# Google Tag Manager: sem a variável, usa GTM-WPRVL288; deixar vazio desliga
# PUBLIC_GTM_ID=
# GA4 direto (gtag.js): sem a variável, usa G-2YVE958NV1; deixar vazio desliga
# (se o mesmo GA4 também estiver como tag dentro do Tag Manager, a medição sai em dobro)
# PUBLIC_GA4_ID=
# Microsoft Clarity (ID do projeto)
PUBLIC_CLARITY_ID=

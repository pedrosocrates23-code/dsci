# Domínio definitivo (sem barra no fim). Enquanto vazio, o site sai em noindex.
SITE_URL=

# Contato (opcional até definir): aparecem no rodapé e na página Contact quando preenchidos
PUBLIC_CONTACT_EMAIL=
PUBLIC_LINKEDIN_URL=
PUBLIC_CNPJ=

# Formulário de contato (função /api/contact/ na Vercel), envio via Resend
RESEND_API_KEY=
# Caixa que recebe os contatos do site (quem faz o 1º contato com o lead; o "Responder" vai direto para quem escreveu)
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Anti-spam opcional (Cloudflare Turnstile)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GA4 opcional, com Consent Mode (barra de consentimento só aparece se houver ID)
PUBLIC_GA4_ID=

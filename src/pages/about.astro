---
/**
 * ENTITY HOME da organização (plano v2, seção 5): o nó Organization completo mora aqui.
 * Texto de 8.2 reescrito sem atribuir à empresa a experiência da autora (tabela 9.1).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMedia from '../components/HeroMedia.astro';
import CtaBand from '../components/CtaBand.astro';
import AuthorshipBox from '../components/AuthorshipBox.astro';
import { PAGES } from '../config/pages';
import { BRAND } from '../config/site';
import { graph, websiteNode, webPageNode, breadcrumbNode, organizationNode, orgRef } from '../lib/schema';

const meta = PAGES.about;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'About', path: meta.path }];
const audiences = ['Pharmaceutical companies', 'Medical device companies', 'Animal health companies', 'Biotechnology companies', 'Cosmetic brands', 'Ingredient suppliers'];

const jsonLd = graph(
  websiteNode(),
  webPageNode({ path: meta.path, name: meta.title, description: meta.description, type: 'AboutPage', crumbs, about: orgRef, mainEntity: orgRef }),
  breadcrumbNode(meta.path, crumbs),
  organizationNode(),
);
---
<BaseLayout title={meta.title} description={meta.description} path={meta.path} jsonLd={jsonLd} heroImage="about-hero">
  <section class="phero on-dark">
    <HeroMedia image="about-hero" position="50% center" />
    <div class="wrap phero__inner">
      <h1 class="h-1 phero__title">Bench science in the service of regulatory approval.</h1>
      <p class="phero__sub">Our mission is to make safety assessment more robust, more agile and less dependent on animals.</p>
    </div>
  </section>

  <section class="section who">
    <div class="wrap who__grid">
      <h2 class="h-2" data-reveal>Who we are</h2>
      <div class="who__text">
        <p class="who__big" data-reveal>{BRAND.name} works where toxicological data become regulatory documentation: building the right evidence and turning it into documents that agencies can assess.</p>
        <p data-reveal>We provide regulatory toxicology and nonclinical strategy based in {BRAND.location}, serving clients remotely in Brazil and abroad, in English or Portuguese.</p>
      </div>
    </div>
  </section>

  <section class="section section--alice serve">
    <div class="wrap">
      <h2 class="h-2 serve__title">Who we work with</h2>
      <ul class="serve__list">
        {audiences.map((a) => <li data-reveal>{a}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap"><AuthorshipBox /></div>
  </section>

  <CtaBand title="Shall we talk about your program?" cta="Request a proposal" />
</BaseLayout>

<style>

  .who__grid { display: grid; grid-template-columns: 0.6fr 1.4fr; gap: 48px; }
  .who h2 { color: var(--navy); }
  .who__text { display: grid; gap: 22px; }
  .who__big { font-family: var(--f-display); font-size: clamp(1.4rem, 2.4vw, 2rem); line-height: 1.3; letter-spacing: -0.02em; color: var(--navy); }
  .who__text p:last-child { color: var(--muted); font-size: 1.12rem; max-width: 64ch; }
  @media (max-width: 860px) { .who__grid { grid-template-columns: 1fr; gap: 20px; } }

  .serve__title { color: var(--navy); }
  .serve__list { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 24px; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .serve__list li { padding: 26px 24px; font-family: var(--f-display); font-weight: 600; font-size: 1.15rem; color: var(--navy); border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--white); }
  @media (max-width: 760px) { .serve__list { grid-template-columns: 1fr; } }
</style>

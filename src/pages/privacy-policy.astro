---
/** Política simples (prompt, seção 10). Texto a revisar pelo jurídico da cliente (N7: GDPR). */
import BaseLayout from '../layouts/BaseLayout.astro';
import { PAGES } from '../config/pages';
import { BRAND, CONTACT, INTEGRATIONS, HAS_ANALYTICS } from '../config/site';
import { graph, websiteNode, webPageNode, breadcrumbNode, orgRef } from '../lib/schema';

const meta = PAGES.privacy;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Privacy policy', path: meta.path }];
// Ferramentas de medição ativas, no texto de cookies (só o que está de fato ligado).
const analyticsTools = [
  INTEGRATIONS.gtm && 'analytics tags loaded through Google Tag Manager',
  INTEGRATIONS.ga4 && 'Google Analytics',
  INTEGRATIONS.clarity && 'Microsoft Clarity',
].filter(Boolean).join(' and ');
const jsonLd = graph(websiteNode(), webPageNode({ path: meta.path, name: meta.title, description: meta.description, crumbs, about: orgRef }), breadcrumbNode(meta.path, crumbs));
---
<BaseLayout title={meta.title} description={meta.description} path={meta.path} jsonLd={jsonLd}>
  <section class="legal-hero on-dark">
    <div class="wrap"><h1 class="h-1">Privacy policy</h1><p class="muted-light">Last updated: October 31, 2026</p></div>
  </section>
  <article class="section legal">
    <div class="wrap legal__body">
      <h2 class="h-3">Who we are</h2>
      <p>{BRAND.name} is a regulatory toxicology and nonclinical strategy consultancy based in {BRAND.location}. This policy explains how we handle the personal data sent through the contact form on this website, under Brazil's General Data Protection Law (LGPD, Law No. 13,709/2018).</p>

      <h2 class="h-3">What data we collect</h2>
      <p>When you use the contact form, we receive the data you enter: name, work email, area of activity and the message about your project. We ask you not to include confidential product data in this first contact.</p>

      <h2 class="h-3">Why we use it</h2>
      <p>We use these data only to reply to your contact, schedule a diagnostic meeting and prepare a proposal, based on the consent you give when you submit the form.</p>

      <h2 class="h-3">Who processes it</h2>
      <p>The site is hosted by Vercel, and form messages are delivered by a transactional email provider. These providers process the data only to deliver this service.{HAS_ANALYTICS && ` If you accept analytics cookies, we measure how the site is used with ${analyticsTools}; without your consent, no analytics cookie is set.`}</p>

      <h2 class="h-3">How long we keep it</h2>
      <p>We keep contact data for as long as needed to respond and, if a project follows, for the duration of the business relationship.</p>

      <h2 class="h-3">Your rights</h2>
      <p>You may request access to, correction or deletion of your data, and withdraw your consent at any time{CONTACT.email ? <> by writing to <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></> : ' through the contact form'}.</p>

      <h2 class="h-3">Cookies</h2>
      <p>This site does not use advertising cookies. {HAS_ANALYTICS ? 'Analytics cookies are only set after you accept them in the consent bar.' : 'No analytics cookies are currently in use.'}</p>
    </div>
  </article>
</BaseLayout>
<style>
  .legal-hero { background: var(--navy); padding: 170px 0 64px; }
  .legal-hero .wrap { display: grid; gap: 14px; }
  .muted-light { color: rgba(255,255,255,.7); }
  .legal__body { max-width: 760px; display: grid; gap: 14px; }
  .legal__body h2 { color: var(--navy); margin-top: 18px; }
  .legal__body p { color: var(--muted); }
</style>

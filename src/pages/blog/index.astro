---
/**
 * /blog/ — HUB do silo (decisão da usuária, 31/10): todas as categorias e cartões, cada um
 * abrindo o artigo em /blog/{categoria}/{artigo}/.
 * Indexável sempre (está no menu e tem conteúdo próprio): sem posts, mostra os artigos da autora
 * na imprensa especializada. No `astro dev`, mostra cartões de PRÉVIA (nunca vão para o build).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogHub from '../../components/BlogHub.astro';
import { PAGES } from '../../config/pages';
import { getEntry } from 'astro:content';
import { getPosts, getTopicsWithPosts, topicPath } from '../../lib/blog';
import { toCard, PREVIEW_CARDS } from '../../lib/hub';
import { graph, websiteNode, webPageNode, breadcrumbNode } from '../../lib/schema';

const posts = await getPosts();
const topics = await getTopicsWithPosts();
const empty = posts.length === 0;
const preview = empty && import.meta.env.DEV;
const cards = preview ? PREVIEW_CARDS : await Promise.all(posts.map(toCard));
const author = empty ? await getEntry('authors', 'jordana-andrade-santos') : null;
const path = '/blog/';
const latest = posts.map((p) => (p.data.updated ?? p.data.pubDate).toISOString().slice(0, 10)).sort().pop();
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Blog', path }];
const jsonLd = graph(websiteNode(), webPageNode({ path, name: PAGES.blog.title, description: PAGES.blog.description, type: 'CollectionPage', crumbs }), breadcrumbNode(path, crumbs));
---
<BaseLayout title={PAGES.blog.title} description={PAGES.blog.description} path={path} jsonLd={jsonLd} updated={latest ?? PAGES.blog.updated}>
  <section class="blog-hero on-dark">
    <div class="wrap">
      <h1 class="h-1">NAMs, regulatory toxicology and nonclinical strategy.</h1>
      {topics.length > 0 && (
        <nav class="topics" aria-label="Categories">{topics.map(({ topic }) => <a href={topicPath(topic.id)}>{topic.data.name}</a>)}</nav>
      )}
    </div>
  </section>
  <section class="section">
    {cards.length > 0 ? (
      <div class="wrap"><BlogHub cards={cards} preview={preview} /></div>
    ) : (
      <div class="wrap soon">
        <h2 class="h-2">The first articles are on their way.</h2>
        <p class="lead">Meanwhile, read the technical articles published in the specialist press.</p>
        {author && (
          <ul class="soon__list">
            {author.data.externalArticles.map((a) => (
              <li><a href={a.url} target="_blank" rel="noopener"><span class="soon__meta">{a.outlet} · {a.year}</span><span class="soon__title">{a.title}</span><span class="soon__by">By {author.data.name}, {author.data.honorificSuffix}</span></a></li>
            ))}
          </ul>
        )}
      </div>
    )}
  </section>
</BaseLayout>
<style>
  .blog-hero { background: var(--navy); padding: 170px 0 64px; }
  .blog-hero .wrap { display: grid; gap: 16px; }
  .blog-hero h1 { max-width: 20ch; }
  .topics { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
  .topics a { padding: 8px 14px; border-radius: 5px; border: 1px solid var(--glass-border); color: #fff; text-decoration: none; font-family: var(--f-ui); font-size: 0.92rem; }
  .topics a:hover { background: rgba(255,255,255,.12); }
  .soon { display: grid; gap: 16px; }
  .soon h2 { color: var(--navy); }
  .soon__list { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 16px; }
  .soon__list a { display: grid; gap: 8px; height: 100%; padding: 28px; border: 1px solid var(--line); border-radius: var(--r); text-decoration: none; transition: border-color .2s, box-shadow .3s; }
  .soon__list a:hover { border-color: var(--baltic); box-shadow: var(--shadow); }
  .soon__meta { font-family: var(--f-ui); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--mint-ink); }
  .soon__title { font-family: var(--f-display); font-weight: 600; font-size: 1.25rem; color: var(--navy); line-height: 1.25; }
  .soon__by { color: var(--muted); font-size: 0.95rem; }
  @media (max-width: 760px) { .soon__list { grid-template-columns: 1fr; } }
</style>

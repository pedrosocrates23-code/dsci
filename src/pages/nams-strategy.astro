---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMedia from '../components/HeroMedia.astro';
import CtaBand from '../components/CtaBand.astro';
import SectionImage from '../components/SectionImage.astro';
import AuthorshipBox from '../components/AuthorshipBox.astro';
import Icon from '../components/Icon.astro';
import { PAGES } from '../config/pages';
import { graph, websiteNode, webPageNode, breadcrumbNode, serviceNode } from '../lib/schema';

const meta = PAGES.nams;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'NAMs Strategy', path: meta.path }];

const steps = [
  { t: 'Collection and assessment of existing data.', d: 'A structured review of the literature, public databases and the client’s internal data, assessing the quality and relevance of each piece of information.' },
  { t: 'Assessment of in silico approaches and read-across.', d: 'Analysis of whether computational models and data from analogous substances can answer questions without new studies.' },
  { t: 'Gap analysis and assay definition.', d: 'A comparison between the available evidence and the regulatory requirements, with a roadmap of the assays that are truly needed, prioritizing qualified non-animal methods.' },
  { t: 'Laboratory guidance and study oversight.', d: 'Tailored data generation with partner laboratories and CROs: protocol design, scientific oversight of execution and critical reading of the results.' },
  { t: 'Reports and regulatory documentation.', d: 'Study reports, weight-of-evidence rationales, waiver justifications and CTD nonclinical modules.' },
];
const results = [
  { icon: 'clock', t: 'Less time', d: 'Redundant studies removed from the timeline.' },
  { icon: 'coin', t: 'Lower cost', d: 'Investment focused on the assays that make a difference.' },
  { icon: 'leaf', t: 'Fewer animals', d: 'A real commitment to the 3Rs.' },
  { icon: 'doc-check', t: 'Ready for the agencies', d: 'Documented, traceable rationales.' },
] as const;

const fihDesc = 'Definition of the minimum set of nonclinical evidence needed to start studies in humans, prioritizing published data and qualified non-animal methods, with a scientific rationale aligned with ICH M3(R2).';
const waiverDesc = 'Scientific rationales that show, based on existing evidence, why a specific study is not needed, for inclusion in regulatory submissions or in responses to agency questions.';

const jsonLd = graph(
  websiteNode(),
  webPageNode({
    path: meta.path, name: meta.title, description: meta.description, crumbs,
    about: { '@type': 'Thing', name: 'New approach methodologies (NAMs)', sameAs: 'https://www.wikidata.org/wiki/Q140419703' },
  }),
  breadcrumbNode(meta.path, crumbs),
  serviceNode({ path: meta.path, anchor: 'fih', name: 'Minimum evidence package for first-in-human (FIH) administration', description: fihDesc, serviceType: 'First-in-human (FIH) nonclinical package', audience: 'Pharmaceutical and biotechnology companies' }),
  serviceNode({ path: meta.path, anchor: 'waivers', name: 'Study waiver justifications', description: waiverDesc, serviceType: 'Study waiver justification', audience: 'Pharmaceutical and biotechnology companies' }),
);
---
<BaseLayout title={meta.title} description={meta.description} path={meta.path} jsonLd={jsonLd} heroImage="nams-strategy-hero">
  <section class="phero on-dark">
    <HeroMedia image="nams-strategy-hero" position="60% center" />
    <div class="wrap phero__inner">
      <h1 class="h-1 phero__title">NAMs in nonclinical strategy: solid science, fewer studies.</h1>
      <p class="phero__sub">We integrate existing data, in silico approaches and qualified non-animal methods into nonclinical strategies acceptable to regulatory agencies.</p>
    </div>
  </section>

  <!-- POR QUE AGORA -->
  <section class="section">
    <div class="wrap whynow">
      <h2 class="h-2 whynow__title" data-reveal>Why now</h2>
      <p data-reveal>Regulatory agencies are increasingly open to non-animal methods and existing data to support safety decisions. ICH M3(R2) and other guidelines already provide for weight-of-evidence approaches.</p>
      <p data-reveal>For industry, this means the opportunity to avoid redundant studies, reduce costs and timelines, and advance the commitment to the 3Rs (replacement, reduction and refinement of animal use).</p>
    </div>
  </section>

  <!-- O DESAFIO: declaração em escala -->
  <section class="section section--alice challenge">
    <div class="wrap challenge__grid">
      <h2 class="challenge__quote" data-reveal>NAMs are not a shortcut. <span>They are strategy.</span></h2>
      <p class="lead" data-reveal>Not every toxicological endpoint can be answered today without animal studies, and many methods are not yet accepted for every regulatory use. Using NAMs without criteria can generate data that do not convince the agency and delay the program. The value lies in knowing where each approach applies, how to combine them and how to justify the choice.</p>
    </div>
  </section>

  <!-- ABORDAGEM: linha do tempo vertical com número fixo -->
  <section class="section approach" id="approach">
    <div class="wrap approach__grid">
      <div class="approach__head">
        <h2 class="h-1">From existing evidence to the dossier.</h2>
        <p class="lead">Each step can be contracted separately or as a complete project.</p>
      </div>
      <ol class="timeline" data-timeline>
        <span class="timeline__rail" aria-hidden="true"><span class="timeline__fill" data-draw></span></span>
        {steps.map((s, i) => (
          <li class="timeline__item" data-reveal>
            <span class="timeline__n">{i + 1}</span>
            <h3 class="h-3">{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- APLICAÇÕES: #fih e #waivers -->
  <section class="section section--alice apps">
    <div class="wrap">
      <div class="apps__grid">
        <article id="fih" class="app app--fih on-dark" data-reveal>
          <p class="app__tag">FIH</p>
          <h2 class="h-3">Minimum evidence package for first-in-human (FIH) administration</h2>
          <p>{fihDesc}</p>
          <p class="app__label">Deliverables</p>
          <ul>
            <li>Gap analysis against FIH requirements</li>
            <li>Structured literature review</li>
            <li>NAMs strategy to fill the gaps</li>
            <li>Weight-of-evidence rationale</li>
            <li>Position paper for meetings and submissions (e.g., Pre-IND)</li>
          </ul>
        </article>
        <article id="waivers" class="app app--waivers" data-reveal>
          <p class="app__tag">Waivers</p>
          <h2 class="h-3">Study waiver justifications</h2>
          <p>{waiverDesc}</p>
          <p class="app__label">Deliverables</p>
          <ul>
            <li>Waiver feasibility assessment</li>
            <li>Technical and scientific justification document, with traceable references</li>
            <li>Support in responding to agency questions</li>
          </ul>
        </article>
      </div>
      <p class="apps__note">Final acceptance rests with the regulatory agency; D-Sci’s work is to build the strongest possible scientific justification.</p>
    </div>
  </section>

  <!-- COSMÉTICOS -->
  <section class="cosm on-dark">
    <SectionImage image="sec-cosmetics-flatlay" bg sizes="100vw" />
    <div class="wrap cosm__inner">
      <p>For cosmetics and ingredients, we design animal-free testing strategies for eye irritation, skin irritation and sensitization based on OECD guidelines, including CRO selection and the interpretation of test reports.</p>
      <a class="link-arrow" href="/services/#cosmetics">See services for cosmetics</a>
    </div>
  </section>

  <!-- RESULTADO -->
  <section class="section">
    <div class="wrap">
      <h2 class="h-2 results__title" data-reveal>The result</h2>
      <ul class="results">
        {results.map((r) => (
          <li data-reveal>
            <span class="results__icon"><Icon name={r.icon} /></span>
            <h3 class="h-3">{r.t}</h3>
            <p>{r.d}</p>
          </li>
        ))}
      </ul>
      <div class="nams-author"><AuthorshipBox /></div>
    </div>
  </section>

  <CtaBand title="Want to know which studies your program really needs?" cta="Request a gap analysis" />
</BaseLayout>

<script>
  // Linha do passo a passo: vai do centro do quadro 1 ao centro do último quadro.
  const tl = document.querySelector<HTMLElement>('[data-timeline]');
  const last = tl?.querySelector<HTMLElement>('.timeline__item:last-child .timeline__n');
  if (tl && last) {
    // offsetTop (layout) e não getBoundingClientRect: ignora o deslocamento da animação de entrada.
    const fit = () => {
      const end = tl.offsetHeight - (last.parentElement!.offsetTop + last.offsetTop + last.offsetHeight / 2);
      tl.style.setProperty('--rail-end', `${Math.max(0, Math.round(end))}px`);
    };
    fit();
    new ResizeObserver(fit).observe(tl);
  }
</script>

<style>

  .whynow { display: grid; grid-template-columns: 0.7fr 1fr 1fr; gap: 40px; align-items: start; }
  .whynow__title { color: var(--navy); }
  .whynow p { font-size: 1.12rem; color: var(--muted); }
  @media (max-width: 860px) { .whynow { grid-template-columns: 1fr; gap: 18px; } }

  .challenge__grid { display: grid; gap: 32px; }
  .challenge__quote { font-size: clamp(2.2rem, 5.4vw, 4.6rem); color: var(--navy); letter-spacing: -0.035em; line-height: 1.02; max-width: 16ch; }
  .challenge__quote span { color: var(--baltic); }
  .challenge .lead { max-width: 70ch; }

  .approach__grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 64px; align-items: start; }
  .approach__head { position: sticky; top: 120px; display: grid; gap: 16px; }
  .approach__head h2 { color: var(--navy); }
  .timeline { position: relative; list-style: none; display: grid; gap: 0; padding-left: 84px; }
  /* A linha termina no centro do quadro 5: o `bottom` exato é medido no script abaixo (a altura
     do último item varia com a quebra do texto); sem JS, fica o valor aproximado. */
  .timeline__rail { position: absolute; left: 27px; top: 8px; bottom: var(--rail-end, 120px); width: 2px; background: var(--line); }
  .timeline__fill { position: absolute; inset: 0; background: var(--mint); transform-origin: top center; }
  .timeline__item { position: relative; padding: 0 0 44px; display: grid; gap: 8px; }
  .timeline__n {
    position: absolute; left: -84px; top: -6px; width: 56px; height: 56px; display: grid; place-items: center;
    border-radius: var(--r); background: var(--navy); color: #fff; font-family: var(--f-display); font-weight: 600; font-size: 1.2rem;
  }
  .timeline__item h3 { color: var(--navy); }
  .timeline__item p { color: var(--muted); }
  @media (max-width: 960px) { .approach__grid { grid-template-columns: 1fr; gap: 36px; } .approach__head { position: static; } }

  .apps__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 22px; }
  .app { padding: clamp(28px, 3.5vw, 44px); border-radius: var(--r); display: grid; gap: 14px; align-content: start; scroll-margin-top: 110px; }
  .app--fih { background: var(--baltic); }
  .app--waivers { background: var(--white); border: 1px solid var(--line); }
  .app--waivers h2 { color: var(--navy); }
  .app--waivers p { color: var(--muted); }
  .app__tag { font-family: var(--f-display); font-weight: 700; font-size: 2.6rem; letter-spacing: -0.04em; line-height: 1; }
  .app--fih .app__tag { color: #fff; }
  .app--waivers .app__tag { color: var(--baltic); }
  .app__label { font-family: var(--f-ui); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-top: 6px; }
  .app--fih .app__label { color: #fff; }
  .app--waivers .app__label { color: var(--mint-ink) !important; }
  .app ul { list-style: none; display: grid; gap: 8px; }
  .app li { padding-left: 22px; position: relative; }
  .app li::before { content: ''; position: absolute; left: 2px; top: 0.42em; width: 6px; height: 11px; border: 2px solid currentColor; border-right: 0; }
  .app--fih li { color: #fff; }
  .app--waivers li { color: var(--ink); }
  .app--fih li::before { color: #fff; }
  .app--waivers li::before { color: var(--mint-ink); }
  .apps__note { margin-top: 22px; font-size: 0.95rem; color: var(--muted); max-width: 80ch; }
  @media (max-width: 860px) { .apps__grid { grid-template-columns: 1fr; } }

  .cosm { position: relative; isolation: isolate; overflow: hidden; background: var(--navy); padding-block: clamp(56px, 7vw, 88px); --simg-opacity: 0.14; }
  .cosm__inner { position: relative; }
  .cosm__inner { display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap; }
  .cosm p { max-width: 74ch; font-size: 1.1rem; }

  .results__title { color: var(--navy); margin-bottom: 32px; }
  .results { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 1px solid var(--line); }
  .results li { padding: 28px 24px 28px 0; display: grid; gap: 10px; border-right: 1px solid var(--line); }
  .results li + li { padding-left: 24px; }
  .results li:last-child { border-right: 0; }
  .results__icon { color: var(--baltic); }
  .results h3 { color: var(--navy); }
  .results p { color: var(--muted); }
  @media (max-width: 860px) { .results { grid-template-columns: 1fr 1fr; } .results li:nth-child(2) { border-right: 0; } .results li:nth-child(3) { padding-left: 0; } }
  .nams-author { margin-top: 72px; }
</style>

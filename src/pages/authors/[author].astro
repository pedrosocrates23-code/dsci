---
/**
 * Página de autora (plano v2, 6.1; arquitetura v2-EN). Casa do nó Person (@id = ORCID).
 * Fase 1: sem cargo, sem empregador, sem "at D-Sci Consulting", sem link para /about/.
 * Breadcrumb: Home > nome (o nível /authors/ não existe).
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PAGES } from '../../config/pages';
import { postPath } from '../../lib/blog';
import { SHOW_AUTHOR_CREDENTIALS } from '../../config/site';
import { graph, websiteNode, webPageNode, breadcrumbNode, personNode } from '../../lib/schema';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((a) => ({ params: { author: a.id }, props: { author: a } }));
}
const { author } = Astro.props;
const a = author.data;
const path = `/authors/${author.id}/`;
const meta = author.id === 'jordana-andrade-santos' ? PAGES.author : { title: `${a.name}: author | D-Sci Consulting`, description: a.bio.slice(0, 155) };
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.person.id === author.id))
  .sort((x, y) => y.data.pubDate.valueOf() - x.data.pubDate.valueOf());
const latest = [PAGES.author.updated, ...posts.map((p) => (p.data.updated ?? p.data.pubDate).toISOString().slice(0, 10))].sort().pop();
const display = a.honorificSuffix ? `${a.name}, ${a.honorificSuffix}` : a.name;
const crumbs = [{ name: 'Home', path: '/' }, { name: display, path }];

const jsonLd = graph(
  websiteNode(),
  webPageNode({ path, name: meta.title, description: meta.description, type: 'ProfilePage', crumbs, mainEntity: { '@id': a.orcid } }),
  breadcrumbNode(path, crumbs),
  personNode(a, path),
);
const orcidNum = a.orcid.split('/').pop();
---
<BaseLayout title={meta.title} description={meta.description} path={path} jsonLd={jsonLd} ogType="profile" updated={latest}>
  <section class="author-hero on-dark">
    <div class="wrap author-hero__grid">
      <div>
        <h1 class="h-1">{display}</h1>
        <p class="author-hero__bio">{a.bio}</p>
      </div>
      <dl class="ids" aria-label="Identifiers">
        <div><dt>ORCID</dt><dd><a href={a.orcid} rel="noopener" target="_blank">{orcidNum}</a></dd></div>
        {a.openalex && <div><dt>OpenAlex</dt><dd><a href={a.openalex} rel="noopener" target="_blank">Author profile</a></dd></div>}
      </dl>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2 class="h-2 sec-title">Articles on this site</h2>
        <ul class="list">
          {posts.map((p) => (
            <li><a href={postPath(p)}><span class="list__meta">{p.data.byline === 'author' ? 'Author' : 'Technical reviewer'} · {p.data.pubDate.toISOString().slice(0, 10)}</span><span class="list__title">{p.data.title}</span></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {a.externalArticles.length > 0 && (
    <section class="section section--alice">
      <div class="wrap">
        <h2 class="h-2 sec-title">In the specialist press</h2>
        <ul class="list">
          {a.externalArticles.map((x) => (
            <li><a href={x.url} target="_blank" rel="noopener"><span class="list__meta">{x.outlet} · {x.year}</span><span class="list__title">{x.title}</span></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {SHOW_AUTHOR_CREDENTIALS && a.credentials.length > 0 && (
    <section class="section">
      <div class="wrap creds">
        {a.credentials.map((c) => (
          <div><h2 class="h-3">{c.group}</h2><ul>{c.items.map((i) => <li>{i}</li>)}</ul></div>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
<style>
  .author-hero { background: var(--navy); padding: 170px 0 80px; }
  .author-hero__grid { display: grid; grid-template-columns: 1.4fr 0.6fr; gap: 48px; align-items: end; }
  .author-hero h1 { margin: 14px 0 18px; }
  .author-hero__bio { max-width: 62ch; font-size: 1.18rem; color: rgba(255,255,255,.86); }
  .ids { margin: 0; display: grid; gap: 0; border: 1px solid var(--line-dark); border-radius: 8px; overflow: hidden; background: rgba(255,255,255,.05); }
  .ids div { padding: 16px 18px; border-bottom: 1px solid var(--line-dark); }
  .ids div:last-child { border-bottom: 0; }
  .ids dt { font-family: var(--f-ui); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mint); }
  .ids dd { margin: 4px 0 0; font-size: 1.05rem; }
  @media (max-width: 860px) { .author-hero__grid { grid-template-columns: 1fr; } }
  .sec-title { color: var(--navy); margin-bottom: 24px; }
  .list { list-style: none; border-top: 1px solid var(--line); }
  .list a { position: relative; display: grid; gap: 6px; padding: 22px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .list a:hover .list__title { text-decoration: underline; }
  .list__meta { font-family: var(--f-ui); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--mint-ink); }
  .list__title { font-family: var(--f-display); font-weight: 600; font-size: 1.2rem; color: var(--navy); }
  .creds { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .creds h2 { color: var(--navy); margin-bottom: 12px; }
  .creds ul { padding-left: 18px; color: var(--muted); display: grid; gap: 6px; }
  @media (max-width: 860px) { .creds { grid-template-columns: 1fr; } }
</style>

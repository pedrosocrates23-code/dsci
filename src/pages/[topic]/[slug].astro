---
/**
 * Artigo: /{categoria}/{artigo}/ (silo na raiz; /blog/ é só o hub).
 * Breadcrumb: Home > Categoria > Artigo. Assinatura (plano v2, 4.2):
 *  byline 'author'   → "By ..."          → BlogPosting.author = pessoa (ORCID)
 *  byline 'reviewer' → "Reviewed by ..." → author = organização; reviewedBy/lastReviewed no WebPage
 * Layout: hero navy (continua a transição do cartão), capa, sumário lateral, corpo, autora e
 * serviço relacionado. No `astro dev` sem posts: páginas de PRÉVIA (a 1ª com texto de exemplo).
 */
import { getEntry, render, type CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SampleArticle from '../../components/SampleArticle.astro';
import { getPosts, fmtDate, isoDate, postPath, topicPath } from '../../lib/blog';
import { PREVIEW_CARDS, supportsLabel, type HubCard } from '../../lib/hub';
import { graph, websiteNode, webPageNode, breadcrumbNode, orgRef, abs } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getPosts();
  if (posts.length) return posts.map((p) => ({ params: { topic: p.data.topic.id, slug: p.id }, props: { post: p } }));
  if (!import.meta.env.DEV) return [];
  return PREVIEW_CARDS.map((c) => ({ params: { topic: c.topicId, slug: c.href.split('/')[2] }, props: { previewCard: c } }));
}
interface Props { post?: CollectionEntry<'blog'>; previewCard?: HubCard; }
const { post, previewCard } = Astro.props;

const author = await getEntry('authors', 'jordana-andrade-santos');
const SAMPLE_HEADINGS = [
  { slug: 'what-the-package-answers', text: 'What the package needs to answer' },
  { slug: 'start-from-existing-data', text: 'Start from the data that already exist' },
  { slug: 'where-nams-fit', text: 'Where NAMs and in silico approaches fit' },
  { slug: 'documenting-the-rationale', text: 'Documenting the rationale' },
  { slug: 'when-a-study-is-needed', text: 'When a traditional study is still needed' },
];

let page: {
  path: string; title: string; description: string; topicId: string; topicName: string; pubDate?: Date; updated?: Date;
  bylineLabel: string; personName: string; authorPath: string; supports: string; cover?: ImageMetadata; coverAlt: string;
  headings: { slug: string; text: string }[]; minutes: number; jsonLd?: string; preview: boolean; sample: boolean;
};
let Content: any = null;

if (post) {
  const d = post.data;
  const person = await getEntry(d.person);
  const topic = await getEntry(d.topic);
  if (!person) throw new Error(`[blog] autor inexistente em ${post.id}`);
  const rendered = await render(post);
  Content = rendered.Content;
  const path = postPath(post);
  const url = abs(path);
  const personName = person.data.honorificSuffix ? `${person.data.name}, ${person.data.honorificSuffix}` : person.data.name;
  const topicName = topic?.data.name ?? d.topic.id;
  const crumbs = [{ name: 'Home', path: '/' }, { name: topicName, path: topicPath(d.topic.id) }, { name: d.title, path }];
  const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
  page = {
    path, title: d.title, description: d.description, topicId: d.topic.id, topicName, pubDate: d.pubDate, updated: d.updated,
    bylineLabel: d.byline === 'author' ? 'By' : 'Reviewed by', personName, authorPath: `/authors/${person.id}/`,
    supports: d.supports, cover: d.cover, coverAlt: d.coverAlt ?? '', preview: false, sample: false,
    headings: rendered.headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text })),
    minutes: Math.max(1, Math.round(words / 220)),
    jsonLd: graph(
      websiteNode(),
      webPageNode({ path, name: d.title, description: d.description, crumbs,
        extra: d.byline === 'reviewer' ? { reviewedBy: { '@id': person.data.orcid }, lastReviewed: isoDate(d.approval.approvedOn) } : {} }),
      breadcrumbNode(path, crumbs),
      {
        '@type': 'BlogPosting', '@id': url + '#article', url, headline: d.title, description: d.description, inLanguage: 'en',
        datePublished: isoDate(d.pubDate), dateModified: isoDate(d.updated ?? d.pubDate),
        author: d.byline === 'author' ? { '@id': person.data.orcid } : orgRef,
        publisher: orgRef, isPartOf: { '@id': abs('/#website') }, mainEntityOfPage: { '@id': url + '#webpage' },
        articleSection: topicName, image: abs('/og-default.png'),
      },
    ),
  };
} else {
  const c = previewCard!;
  const sample = c.id === 'preview-fih-package';
  page = {
    path: c.href, title: c.title, description: c.description,
    topicId: c.topicId, topicName: c.topicName, bylineLabel: 'By', personName: 'Jordana Andrade Santos, PhD',
    authorPath: '/authors/jordana-andrade-santos/', supports: c.supportsHref, cover: c.cover, coverAlt: '',
    headings: sample ? SAMPLE_HEADINGS : [], minutes: sample ? 4 : 1, preview: true, sample,
  };
}
---
<BaseLayout title={`${page.title} | D-Sci`} description={page.description} path={page.path} jsonLd={page.jsonLd} ogType="article" noindex={page.preview} updated={page.pubDate ? isoDate(page.updated ?? page.pubDate) : undefined}>
  <article class="post">
    <header class:list={['post-hero on-dark', { 'post-hero--cover': Boolean(page.cover) }]}>
      <div class="wrap post-hero__inner">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href={topicPath(page.topicId)}>{page.topicName}</a></nav>
        <h1 class="h-1">{page.title}</h1>
        <p class="byline">
          {page.bylineLabel} <a href={page.authorPath}>{page.personName}</a>
          {page.pubDate ? <> · <time datetime={page.pubDate.toISOString()}>{fmtDate(page.pubDate)}</time></> : <> · Preview</>}
          {page.updated && <> · Updated <time datetime={page.updated.toISOString()}>{fmtDate(page.updated)}</time></>}
          <> · {page.minutes} min read</>
        </p>
      </div>
    </header>

    {page.cover && (
      <div class="wrap post-cover">
        <Picture src={page.cover} alt={page.coverAlt} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[640, 960, 1280, 1600]} sizes="(max-width: 1280px) 100vw, 1240px" loading="eager" fetchpriority="high" />
      </div>
    )}

    <div class="wrap post-layout">
      {page.headings.length > 1 && (
        <nav class="toc" aria-label="On this page">
          <p class="toc__title">On this page</p>
          <ol>{page.headings.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="prose">
        {page.preview && <p class="preview-note">Preview page shown only in local development. URL: <code>{page.path}</code></p>}
        {Content ? <Content /> : page.sample ? <SampleArticle /> : <p>The approved article text will appear here.</p>}

        <footer class="post-end">
          {author && (
            <div class="post-author">
              <p class="post-author__label">{page.bylineLabel === 'By' ? 'About the author' : 'Technical reviewer'}</p>
              <p class="post-author__name"><a href={page.authorPath}>{page.personName}</a></p>
              <p class="post-author__bio">{author.data.bio}</p>
            </div>
          )}
          <a class="post-service" href={page.supports}>
            <span class="post-service__label">Related service</span>
            <span class="post-service__name">{supportsLabel(page.supports)}</span>
            <span class="post-service__cta">See how we work on it</span>
          </a>
          <a class="link-arrow post-back" href="/blog/">All articles</a>
        </footer>
      </div>
    </div>
  </article>
</BaseLayout>
<style>
  .post-hero { background: var(--navy); padding: 160px 0 64px; }
  .post-hero--cover { padding-bottom: 120px; }
  .post-hero__inner { display: grid; gap: 18px; max-width: 900px; }
  .post-hero__inner > * { animation: post-in 0.6s var(--ease-out) both; }
  .post-hero__inner > :nth-child(2) { animation-delay: 0.06s; }
  .post-hero__inner > :nth-child(3) { animation-delay: 0.12s; }
  @keyframes post-in { from { opacity: 0; transform: translateY(18px); } }
  @media (prefers-reduced-motion: reduce) { .post-hero__inner > * { animation: none; } }
  .crumbs { font-family: var(--f-ui); font-size: 0.9rem; color: rgba(255,255,255,.7); }
  .crumbs a { color: rgba(255,255,255,.88); }
  .byline { color: rgba(255,255,255,.82); }
  .byline a { color: var(--mint) !important; font-weight: 600; }

  /* Capa sobreposta ao fim do hero */
  .post-cover { margin-top: -80px; position: relative; z-index: 1; }
  .post-cover :global(img) { width: 100%; aspect-ratio: 21 / 9; object-fit: cover; border-radius: var(--r); box-shadow: var(--shadow); }
  @media (max-width: 760px) { .post-cover { margin-top: -56px; } .post-cover :global(img) { aspect-ratio: 16 / 10; } }

  .post-layout { display: grid; grid-template-columns: 240px minmax(0, 760px); gap: 56px; justify-content: center; padding-block: clamp(48px, 7vw, 88px); }
  .toc { position: sticky; top: 110px; align-self: start; padding-top: 6px; }
  .toc__title { font-family: var(--f-display); font-weight: 600; font-size: 0.95rem; color: var(--navy); margin-bottom: 12px; }
  .toc ol { list-style: none; display: grid; gap: 2px; border-left: 1px solid var(--line); }
  .toc a { display: block; padding: 6px 0 6px 14px; margin-left: -1px; border-left: 2px solid transparent; font-size: 0.92rem; color: var(--muted); text-decoration: none; }
  .toc a:hover { color: var(--navy); border-left-color: var(--mint-ink); }
  @media (max-width: 960px) { .post-layout { grid-template-columns: minmax(0, 1fr); gap: 0; } .toc { display: none; } }

  .prose { font-size: 1.12rem; line-height: 1.75; color: var(--ink); min-width: 0; }
  .prose :global(h2) { font-size: clamp(1.45rem, 2.2vw, 1.8rem); color: var(--navy); margin: 2.2em 0 0.6em; scroll-margin-top: 110px; }
  .prose :global(h3) { font-size: 1.3rem; color: var(--navy); margin: 1.6em 0 0.5em; }
  .prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(blockquote), .prose :global(.table-wrap) { margin: 0 0 1.2em; }
  .prose :global(ul) { list-style: none; padding: 0; }
  .prose :global(ul li) { position: relative; padding-left: 24px; margin-bottom: 0.4em; }
  .prose :global(ul li::before) { content: ''; position: absolute; left: 2px; top: 0.55em; width: 6px; height: 11px; border: 2px solid var(--mint-ink); border-right: 0; }
  .prose :global(ol) { padding-left: 1.4em; }
  .prose :global(ol li) { margin-bottom: 0.4em; padding-left: 4px; }
  .prose :global(ol li::marker) { color: var(--mint-ink); font-family: var(--f-display); font-weight: 600; }
  .prose :global(blockquote) { padding: 4px 0 4px 22px; border-left: 3px solid var(--baltic); font-family: var(--f-display); font-size: 1.35rem; line-height: 1.35; color: var(--navy); }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(.table-wrap) { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--r); }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 0.98rem; }
  .prose :global(th) { text-align: left; background: var(--alice); color: var(--navy); font-family: var(--f-display); font-weight: 600; padding: 12px 14px; }
  .prose :global(td) { padding: 12px 14px; border-top: 1px solid var(--line); vertical-align: top; }
  .prose :global(.callout) { margin: 1.6em 0; padding: 20px 22px; border-radius: var(--r); background: var(--alice); border-left: 4px solid var(--mint-ink); }
  .prose :global(.callout p) { margin: 0; }
  .prose :global(.callout__title) { font-family: var(--f-display); font-weight: 600; color: var(--navy); margin-bottom: 6px !important; }
  .preview-note { padding: 12px 16px; border: 1px dashed var(--baltic); border-radius: var(--r); color: var(--baltic); font-size: 0.95rem; }

  .post-end { margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--line); display: grid; gap: 18px; }
  .post-author { padding: 24px; border: 1px solid var(--line); border-left: 4px solid var(--baltic); border-radius: var(--r); }
  .post-author__label, .post-service__label { font-family: var(--f-ui); font-size: 0.8rem; color: var(--muted); margin: 0 0 4px !important; }
  .post-author__name { font-family: var(--f-display); font-weight: 600; font-size: 1.15rem; margin: 0 0 8px !important; }
  .post-author__name a { color: var(--navy); }
  .post-author__bio { font-size: 1rem; color: var(--muted); margin: 0 !important; }
  .post-service { display: grid; gap: 4px; padding: 24px; border-radius: var(--r); background: var(--navy); color: #fff; text-decoration: none; transition: background 0.25s; }
  .post-service:hover { background: var(--navy-deep); }
  .post-service .post-service__label { color: rgba(255,255,255,.65); }
  .post-service__name { font-family: var(--f-display); font-weight: 600; font-size: 1.3rem; }
  .post-service__cta { color: var(--mint); font-weight: 600; text-decoration: underline; text-underline-offset: 4px; margin-top: 6px; }
  .post-back { justify-self: start; }
</style>

---
/**
 * Busca do site: painel centralizado com o fundo desfocado (cores da marca).
 * Abre pela lupa do menu, por Ctrl/Cmd+K ou "/". Índice em /search-index.json (carregado só
 * na 1ª abertura). Setas navegam, Enter abre, Esc fecha.
 * Sem texto digitado: atalhos + bloco de contato estruturado. Sem resultado: o mesmo bloco.
 */
import { BRAND, CONTACT } from '../config/site';
---
<div class="ssearch" data-search hidden>
  <div class="ssearch__backdrop" data-search-close></div>
  <div class="ssearch__panel" role="dialog" aria-modal="true" aria-label="Search the site">
    <div class="ssearch__bar">
      <svg class="ssearch__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
      <input
        class="ssearch__input" type="search" placeholder="Search services, process, articles or contact"
        autocomplete="off" spellcheck="false" role="combobox" aria-expanded="false" aria-controls="ssearch-results" aria-autocomplete="list"
        aria-label="Search the site" data-search-input
      />
      <button type="button" class="ssearch__esc" data-search-close aria-label="Close search">Esc</button>
    </div>

    <div class="ssearch__drawer" data-search-drawer>
    <div class="ssearch__body">
      <ul class="ssearch__results" id="ssearch-results" role="listbox" aria-label="Results" data-search-results></ul>
      <p class="ssearch__empty" data-search-empty hidden></p>

      <!-- Bloco de contato: sempre útil, sem query e quando não há resultado -->
      <div class="ssearch__contact" data-search-contact hidden>
        <div>
          <p class="ssearch__contact-title">Talk to D-Sci</p>
          <ul class="ssearch__contact-list">
            {CONTACT.email && <li><span>Email</span><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>}
            {CONTACT.linkedin && <li><span>LinkedIn</span><a href={CONTACT.linkedin} target="_blank" rel="me noopener">{BRAND.name}</a></li>}
            <li><span>Base</span>{BRAND.location} · remote service</li>
            <li><span>Language</span>English or Portuguese</li>
          </ul>
        </div>
        <a class="btn btn--navy ssearch__cta" href="/contact/">Request a proposal</a>
      </div>
    </div>
    </div>
  </div>
</div>

<script>
  type Item = { g: string; t: string; d: string; u: string; k?: string; p?: string };
  const root = document.querySelector<HTMLElement>('[data-search]');
  const input = root?.querySelector<HTMLInputElement>('[data-search-input]');
  const list = root?.querySelector<HTMLUListElement>('[data-search-results]');
  const empty = root?.querySelector<HTMLElement>('[data-search-empty]');
  let index: Item[] | null = null;
  let active = -1;
  let lastFocus: HTMLElement | null = null;

  const GROUP_ORDER = ['Contact', 'Services', 'Pages', 'Process', 'FAQ', 'Articles'];
  const contact = root?.querySelector<HTMLElement>('[data-search-contact]');
  // Palavras comuns não contam (frases naturais: "where are you", "how do I sign an nda")
  const STOP = new Set(['a', 'an', 'the', 'is', 'are', 'do', 'does', 'you', 'your', 'i', 'we', 'to', 'of', 'for', 'in', 'on', 'and', 'or', 'can', 'how', 'what', 'my', 'me', 'with', 'about']);
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  async function load() {
    if (index) return index;
    index = await fetch('/search-index.json').then((r) => r.json()).catch(() => []);
    return index!;
  }

  function score(item: Item, terms: string[]) {
    const t = norm(item.t), k = norm(item.k ?? ''), d = norm(item.d), p = norm(item.p ?? '');
    let s = 0;
    for (const term of terms) {
      const inT = t.includes(term), inK = k.includes(term), inP = p.includes(term), inD = d.includes(term);
      if (!inT && !inK && !inP && !inD) return 0; // todas as palavras precisam aparecer
      s += (inT ? (t.startsWith(term) || t.includes(' ' + term) ? 6 : 4) : 0) + (inK ? 3 : 0) + (inP ? 2 : 0) + (inD ? 1 : 0);
    }
    return s;
  }

  function render(items: Item[], query: string) {
    if (!list || !empty) return;
    active = -1;
    input?.removeAttribute('aria-activedescendant');
    if (!items.length) {
      list.innerHTML = '';
      empty.hidden = !query;
      if (contact) contact.hidden = !query; // sem resultado: mostra o contato
      empty.textContent = query ? `No results for "${query}". Try another term, or talk to us directly.` : '';
      input?.setAttribute('aria-expanded', 'false');
      return;
    }
    empty.hidden = true;
    if (contact) contact.hidden = true;
    const groups = new Map<string, Item[]>();
    for (const it of items) { if (!groups.has(it.g)) groups.set(it.g, []); groups.get(it.g)!.push(it); }
    let html = '';
    let n = 0;
    const order = [...groups.keys()].sort((a, b) => GROUP_ORDER.indexOf(a) - GROUP_ORDER.indexOf(b));
    for (const g of order) {
      html += `<li class="ssearch__group" role="presentation">${esc(g)}</li>`;
      for (const it of groups.get(g)!) {
        const external = /^(https?:|mailto:)/.test(it.u);
        html += `<li role="option" id="ss-opt-${n}" class="ssearch__opt" data-i="${n}"><a href="${esc(it.u)}" tabindex="-1"${external && it.u.startsWith('http') ? ' target="_blank" rel="noopener"' : ''}>
          <span class="ssearch__t">${esc(it.t)}</span>
          <span class="ssearch__d">${esc(it.d)}</span>
          ${it.p ? `<span class="ssearch__p">${esc(it.p)}</span>` : ''}</a></li>`;
        n++;
      }
    }
    list.innerHTML = html;
    input?.setAttribute('aria-expanded', 'true');
    setActive(0);
  }

  function setActive(i: number) {
    const opts = list ? [...list.querySelectorAll<HTMLElement>('.ssearch__opt')] : [];
    if (!opts.length) return;
    active = (i + opts.length) % opts.length;
    opts.forEach((o, k) => o.setAttribute('aria-selected', String(k === active)));
    input?.setAttribute('aria-activedescendant', opts[active].id);
    opts[active].scrollIntoView({ block: 'nearest' });
  }

  async function update() {
    const data = await load();
    const q = input?.value.trim() ?? '';
    // Recolhido enquanto não há texto; abre a gaveta de resultados ao digitar.
    root?.classList.toggle('has-query', Boolean(q));
    if (!q) return render([], '');
    const all = norm(q).split(/\s+/).filter(Boolean);
    const kept = all.filter((w) => !STOP.has(w));
    const terms = kept.length ? kept : all;
    const hits = data.map((it) => ({ it, s: score(it, terms) })).filter((x) => x.s > 0).sort((a, b) => b.s - a.s).slice(0, 12).map((x) => x.it);
    render(hits, q);
  }

  function open() {
    if (!root || !input) return;
    lastFocus = document.activeElement as HTMLElement;
    root.hidden = false;
    requestAnimationFrame(() => root.classList.add('is-open'));
    input.value = '';
    update();
    setTimeout(() => input.focus(), 30);
  }
  function close() {
    if (!root || root.hidden) return;
    root.classList.remove('is-open');
    setTimeout(() => { root.hidden = true; }, 220);
    lastFocus?.focus();
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-search-open]')) { e.preventDefault(); open(); return; }
    if (t.closest('[data-search-close]')) close();
    if (t.closest('.ssearch__opt a, .ssearch__contact a')) close();
  });
  document.addEventListener('keydown', (e) => {
    const typing = /input|textarea|select/i.test((e.target as HTMLElement).tagName) || (e.target as HTMLElement).isContentEditable;
    if ((e.key === 'k' && (e.ctrlKey || e.metaKey)) || (e.key === '/' && !typing)) { e.preventDefault(); open(); return; }
    if (root?.hidden) return;
    if (e.key === 'Escape') { e.preventDefault(); close(); }
    else if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
    else if (e.key === 'Enter' && e.target === input) {
      const a = list?.querySelector<HTMLAnchorElement>(`#ss-opt-${active} a`);
      if (a) { e.preventDefault(); a.click(); }
    }
  });
  input?.addEventListener('input', update);
  list?.addEventListener('mousemove', (e) => {
    const opt = (e.target as HTMLElement).closest<HTMLElement>('.ssearch__opt');
    if (opt) setActive(Number(opt.dataset.i));
  });
</script>

<style>
  /* Desktop: a barra fica no meio da tela (64px = altura da barra) e os resultados abrem
     para baixo, sem mover a barra. Celular: no topo. */
  .ssearch { --bar: 64px; --top: calc(50svh - var(--bar) / 2); position: fixed; inset: 0; z-index: 80; display: grid; place-items: start center; padding: var(--top) 16px 16px; }
  .ssearch[hidden] { display: none; }
  .ssearch__backdrop {
    position: absolute; inset: 0; background: rgba(6, 27, 54, 0.5);
    -webkit-backdrop-filter: blur(10px) saturate(140%); backdrop-filter: blur(10px) saturate(140%);
    opacity: 0; transition: opacity 0.22s ease;
  }
  .ssearch__panel {
    position: relative; width: min(720px, 100%); max-height: calc(100svh - var(--top) - 16px); display: grid; grid-template-rows: auto 0fr;
    background: var(--white); border-radius: var(--r-lg); border: 1px solid var(--line); overflow: hidden;
    box-shadow: 0 40px 100px -30px rgba(6, 27, 54, 0.6);
    opacity: 0; transform: translateY(-10px) scale(0.98); transition: opacity 0.22s ease, transform 0.3s var(--ease-out);
  }
  .is-open .ssearch__backdrop { opacity: 1; }
  .is-open .ssearch__panel { opacity: 1; transform: none; }
  /* Gaveta: fechada (0fr) até a pessoa digitar; abre deslizando (1fr). */
  .ssearch__panel { transition: opacity 0.22s ease, transform 0.3s var(--ease-out), grid-template-rows 0.35s var(--ease-out); }
  .has-query .ssearch__panel { grid-template-rows: auto 1fr; }
  .ssearch__drawer { min-height: 0; overflow: hidden; }
  @media (prefers-reduced-motion: reduce) { .ssearch__backdrop, .ssearch__panel { transition: none; } }

  .ssearch__bar { display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: var(--white); }
  .has-query .ssearch__bar { border-bottom: 1px solid var(--line); }
  .ssearch__icon { width: 22px; height: 22px; flex: none; fill: none; stroke: var(--baltic); stroke-width: 1.8; stroke-linecap: round; }
  .ssearch__input {
    flex: 1; min-width: 0; border: 0; outline: none; background: transparent; padding: 8px 0;
    font-family: var(--f-display); font-size: 1.15rem; letter-spacing: -0.01em; color: var(--navy);
  }
  .ssearch__input::placeholder { color: #7f91a2; }
  .ssearch__input::-webkit-search-cancel-button { display: none; }
  .ssearch__esc { flex: none; font-family: var(--f-ui); font-size: 0.75rem; font-weight: 600; color: var(--muted); background: var(--alice); border: 1px solid var(--line); border-radius: 4px; padding: 4px 8px; cursor: pointer; }

  .ssearch__body { height: 100%; max-height: calc(100svh - var(--top) - 16px - var(--bar)); overflow-y: auto; overscroll-behavior: contain; padding: 8px 8px 12px; display: grid; gap: 8px; align-content: start; }
  .ssearch__contact[hidden] { display: none; }
  .ssearch__results { list-style: none; display: grid; gap: 2px; }
  .ssearch__results :global(.ssearch__group) { padding: 12px 12px 6px; font-family: var(--f-display); font-size: 0.85rem; font-weight: 600; color: var(--baltic); }
  .ssearch__results :global(.ssearch__opt a) {
    display: grid; gap: 2px; padding: 10px 12px; border-radius: var(--r); text-decoration: none; border-left: 3px solid transparent;
  }
  .ssearch__results :global(.ssearch__opt[aria-selected='true'] a) { background: var(--alice); border-left-color: var(--mint-ink); }
  .ssearch__results :global(.ssearch__t) { font-family: var(--f-display); font-weight: 600; font-size: 1rem; color: var(--navy); }
  .ssearch__results :global(.ssearch__d) { font-size: 0.9rem; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .ssearch__results :global(.ssearch__p) { font-family: var(--f-ui); font-size: 0.75rem; color: var(--mint-ink); }
  .ssearch__empty { padding: 14px 12px 4px; color: var(--muted); }

  .ssearch__contact {
    margin: 4px 4px 0; padding: 18px 20px; border-radius: var(--r); background: var(--navy); color: #fff;
    display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap;
  }
  .ssearch__contact-title { font-family: var(--f-display); font-weight: 600; font-size: 1.05rem; margin-bottom: 8px; }
  .ssearch__contact-list { list-style: none; display: grid; gap: 4px; font-size: 0.92rem; color: rgba(255, 255, 255, 0.86); }
  .ssearch__contact-list span { display: inline-block; width: 78px; font-family: var(--f-ui); font-size: 0.78rem; color: rgba(255, 255, 255, 0.6); }
  .ssearch__contact-list a { color: var(--mint); }
  .ssearch__contact .ssearch__cta { --bg: var(--mint); --fg: var(--navy-deep); --bd: var(--mint); }
  @media (max-width: 640px) {
    .ssearch { --top: 12px; }
    .ssearch__contact .ssearch__cta { width: 100%; }
  }
</style>

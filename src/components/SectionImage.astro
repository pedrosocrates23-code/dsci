---
/**
 * Imagem de apoio dentro de uma seção: sutil, com proporção fixa (sem CLS) e em AVIF/WebP.
 * Um véu navy bem leve na base amarra a foto à paleta. Imagem ausente: o bloco não é renderizado.
 *
 * O <picture> vai dentro de <noscript>: com JS, o navegador NÃO baixa a foto no carregamento
 * (o `loading="lazy"` do Chrome ainda baixava as fotos perto do topo junto com a foto do hero,
 * e o PageSpeed caía de 100 para 99). O site.ts injeta a foto depois do evento load, quando ela
 * se aproxima da tela. Sem JS, o <noscript> renderiza a foto normalmente.
 */
import { Picture } from 'astro:assets';
import { getSectionImage, SECTION_ALT, type SectionImageKey } from '../lib/images';

interface Props {
  image: SectionImageKey;
  /** Proporção do quadro (CSS aspect-ratio). */
  ratio?: string;
  /** Atributo sizes do srcset: largura real que o quadro ocupa. */
  sizes?: string;
  position?: string;
  class?: string;
  /** Fundo decorativo da seção (sem alt, atrás do conteúdo, opacidade baixa). */
  bg?: boolean;
}
const { image, ratio = '3 / 2', sizes = '(max-width: 860px) 100vw, 45vw', position = 'center', class: cls, bg = false } = Astro.props;
const src = getSectionImage(image);
---
{src && (
  <figure class:list={['simg', { 'simg--bg': bg }, cls]} style={`--ratio:${ratio}`} data-simg aria-hidden={bg ? 'true' : undefined}>
    <noscript><Picture
      src={src}
      alt={bg ? '' : SECTION_ALT[image]}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={62}
      widths={[400, 640, 900, 1200, 1600]}
      sizes={sizes}
      loading="lazy"
      decoding="async"
      class="simg__img"
      style={`object-position:${position}`}
    /></noscript>
  </figure>
)}

<style>
  .simg { position: relative; margin: 0; aspect-ratio: var(--ratio); overflow: hidden; border-radius: var(--r); background: var(--alice); isolation: isolate; }
  .simg :global(picture), .simg :global(img) { display: block; width: 100%; height: 100%; }
  .simg :global(img) { object-fit: cover; }
  /* Entrada sutil da foto injetada pelo site.ts: aparece ao carregar, com um zoom leve se
     ainda estava fora da tela. */
  .simg.is-injected :global(img) { opacity: 0; transition: opacity 0.7s ease, transform 1.4s var(--ease-out); }
  .simg.is-injected.is-armed :global(img) { transform: scale(1.06); }
  .simg.is-injected.is-loaded :global(img) { opacity: 1; }
  .simg.is-injected.is-loaded.is-in :global(img) { transform: scale(1); }
  .simg::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(6, 27, 54, 0) 55%, rgba(6, 27, 54, 0.22) 100%);
    box-shadow: inset 0 0 0 1px rgba(10, 47, 91, 0.08); border-radius: inherit;
  }
  /* Variante de fundo: cobre a seção inteira, atrás do conteúdo (a seção precisa de isolation). */
  .simg--bg { position: absolute; inset: 0; z-index: -1; aspect-ratio: auto; border-radius: 0; background: none; opacity: var(--simg-opacity, 0.16); }
  .simg--bg::after { display: none; }
  .simg--bg :global(img) { filter: grayscale(1) contrast(1.1); }
  @media (prefers-reduced-motion: reduce) { .simg :global(img) { transform: none; transition: none; } }
</style>
